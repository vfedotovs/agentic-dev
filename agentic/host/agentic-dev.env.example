# Copy to /etc/agentic-dev/agentic-dev.env, chmod 600, owned by the cron user.
# This file is sourced by run-stage.sh and its values are passed into every
# container. Keep it out of version control.

# ---- required -----------------------------------------------------------
REPO=your-org/your-repo
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx        # scopes: repo (issues + PRs)

# Which agent runtime drives every stage: 'claude' (Anthropic) or 'grok' (xAI).
# It must match the image you run — build with `make build-claude` or
# `make build-grok`. Only the selected backend's API key is required.
AGENT_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx   # required when AGENT_BACKEND=claude
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxx            # required when AGENT_BACKEND=grok

# ---- pipeline caps (optional) -----------------------------------------
MAX_PER_DAY=10                # Stage 2 & 3: max issues processed per day
MAX_ISSUES=25                 # Stage 1: hard cap on issues created per run
SLICER_DRY_RUN=0             # 1 = Stage 1 prints planned issues, creates none
CONTAINER_TIMEOUT=1200        # per-container wallclock seconds (SIGKILL on breach)
AGENT_MAX_TURNS=              # override the per-stage default (30/60/120) if set
CLAUDE_MAX_TURNS=              # deprecated alias for AGENT_MAX_TURNS; still honoured

# ---- run logging (optional) -------------------------------------------
# The agent's turns are streamed to the container log as one line each, with a
# heartbeat in between so a silent phase still proves the run is alive.
HEARTBEAT_SECS=30             # seconds between heartbeat lines during the agent phase
AGENT_STALL_SECS=300          # quiet time before a heartbeat escalates to STALL
AGENT_LOG_LINE_MAX=200        # stderr truncation width; the full stream is kept on disk

# Loop detection: the same tool call repeating is what an agent burning tokens
# without progressing looks like, and it shows up long before --max-turns or the
# wallclock cap would catch it. Reported by default; set LOOP_ABORT=1 to act on it.
LOOP_REPEAT_LIMIT=5           # identical tool calls in the window before LOOP-SUSPECT
LOOP_WINDOW=20                # how many recent tool calls that window holds
LOOP_ABORT=0                  # 1 = stop the agent when a loop is flagged
PYTEST_TIMEOUT=300            # per-test seconds in the Stage 3 gate (pytest-timeout)

# ---- agent model (optional) -------------------------------------------
GROK_MODEL=                   # e.g. grok-4.6; unset = the CLI's default

# ---- container resources (optional) ---------------------------------
AGENTIC_NET=bridge            # or a locked-down network allowing only GitHub +
                              # the backend's API (api.anthropic.com / api.x.ai)
AGENTIC_MEM=4g
AGENTIC_CPUS=2

# ---- commit identity (optional) ------------------------------------
GIT_AUTHOR_NAME="agentic-dev bot"
GIT_AUTHOR_EMAIL=agentic-dev@users.noreply.github.com

# ---- gc / housekeeping (optional) --------------------------------
GC_DRY_RUN=1                  # 1 = report only (default); 0 = actually close/delete
GC_STALE_DAYS=7              # inactivity before an open agent PR / orphan branch is retired
GC_INPROGRESS_HOURS=24        # reset issues stuck 'in-progress' longer than this
GC_BRANCH_PREFIXES="agent/tests/ agent/impl/"   # branches gc is allowed to touch

# ---- kill switch --------------------------------------------------
AGENTIC_DISABLED=0            # set 1 to pause the whole pipeline (cron still fires, exits early)
